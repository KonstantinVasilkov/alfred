# Telegram bot configuration (uses TELEGRAM__ prefix)
TELEGRAM__BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM__ANTHROPIC_API_KEY=your_anthropic_api_key_here
TELEGRAM__LLM_MODEL=claude-3-haiku-20240307

# Environment
TELEGRAM__ENVIRONMENT=development

# Logging Configuration
TELEGRAM__LOG_LEVEL=INFO
TELEGRAM__LOG_FILE_ENABLED=true
TELEGRAM__LOG_FILE_PATH=./logs
TELEGRAM__LOG_FILE_RETENTION_DAYS=7
TELEGRAM__LOG_FILE_ROTATION=1 day

# OpenTelemetry Configuration
TELEGRAM__OTEL_ENABLED=false
TELEGRAM__OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
TELEGRAM__OTEL_SERVICE_NAME=telegram-bot
TELEGRAM__HONEYCOMB_API_KEY=your_honeycomb_api_key_here

# Sentry Error Tracking
TELEGRAM__SENTRY_DSN=your_sentry_dsn_here
